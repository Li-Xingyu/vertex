# syntax=docker/dockerfile:1.4
FROM node:22.5.1-alpine AS webui
WORKDIR /build/webui
COPY webui/package.json webui/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY webui ./
ARG VERTEX_REVISION=local-provider
ARG VERTEX_BUILD_TIME=unknown
ENV VERTEX_REVISION=${VERTEX_REVISION} VERTEX_BUILD_TIME=${VERTEX_BUILD_TIME}
RUN node prepare-theme.js && npx vue-cli-service build

# Keep the deployed runtime/SQLite ABI and official PUID/PGID entrypoint.
FROM node:22.5.1-alpine AS lineage_deps
WORKDIR /lineage-deps
COPY docker/lineage-db/package.json docker/lineage-db/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

# Isolate the connector dependencies; do not replace the existing app modules.
# That entrypoint drops to vt after initialising the existing /vertex volume;
# switching USER here would break its permission/bootstrap contract.
FROM lswl/vertex@sha256:25104a02b345108e8c7cb2dfbf81a4e5fd38c5d839371584e75629816f06d62f
ARG VERTEX_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/Li-Xingyu/vertex" \
      org.opencontainers.image.revision="${VERTEX_REVISION}" \
      org.opencontainers.image.title="Vertex reliable database and configurable site providers"
COPY app/app.js /app/vertex/app/app.js
COPY app/common /app/vertex/app/common
COPY app/controller /app/vertex/app/controller
COPY app/libs /app/vertex/app/libs
# Versioned installer payload only. Activation remains an explicit NAS change;
# image startup must not overwrite persisted policy, history or rule settings.
COPY app/governance /app/vertex/governance-bundle
COPY app/libs/content-groups /app/vertex/governance-bundle/content-groups
COPY --from=lineage_deps /lineage-deps/node_modules /app/vertex/app/vendor/lineage-db/node_modules
COPY app/model /app/vertex/app/model
COPY app/routes /app/vertex/app/routes
COPY app/config /app/vertex/app/config_backup
# Remove only the base image's bundled UI, so obsolete hashed bundles cannot
# survive a directory-merge COPY. This does not touch the /vertex data volume.
RUN rm -rf /app/vertex/app/static && mkdir -p /app/vertex/app/static
COPY --from=webui /build/app/static /app/vertex/app/static
COPY docker/start.sh /app/vertex/docker/start.sh
RUN sed -i 's/\r$//' /app/vertex/docker/start.sh
COPY test /app/vertex/test
WORKDIR /app/vertex
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "const r=require('http').get({hostname:'127.0.0.1',port:process.env.PORT||3000,path:'/',timeout:3000},s=>{s.resume();process.exit([200,302,401].includes(s.statusCode)?0:1)});r.on('timeout',()=>r.destroy());r.on('error',()=>process.exit(1))"
# Preserve the official CMD, /vertex storage layout and default durability.
