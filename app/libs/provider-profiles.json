  "CARPT": {
    "label": "CARPT",
    "adapter": "html-table",
    "origin": "https://carpt.net",
    "listPath": "/torrents.php",
    "detailPaths": [
      "/details.php"
    ],
    "downloadPaths": [
      "/download.php"
    ],
    "queryKeys": [
      "incldead",
      "cat",
      "spstate",
      "sort",
      "type",
      "inclbookmarked"
    ],
    "params": {
      "incldead": 1
    },
    "budgetCaps": {
      "listPerHour": 36,
      "detailPerHour": 70
    },
    "mapping": {
      "rows": "table.torrents > tbody > tr",
      "authenticated": "a[href*=\"logout.php\"], a[href*=\"userdetails.php\"]",
      "timezoneOffset": 480,
      "fields": {
        "id": {
          "selector": "a[href*=\"details.php\"]",
          "attribute": "href",
          "query": "id"
        },
        "title": {
          "selector": "a[href*=\"details.php\"]"
        },
        "detail": {
          "selector": "a[href*=\"details.php\"]",
          "attribute": "href"
        },
        "download": {
          "selector": "a[href*=\"download.php\"]",
          "attribute": "href"
        },
        "size": {
          "selector": "",
          "header": "img[alt=\"size\"], img[alt=\"Size\"]"
        },
        "seeders": {
          "selector": "",
          "header": "img[alt=\"seeders\"]"
        },
        "leechers": {
          "selector": "",
          "header": "img[alt=\"leechers\"]"
        },
        "publishedAt": {
          "selector": "span[title]",
          "attribute": "title",
          "header": "img[alt=\"time\"], img[alt=\"Time\"]"
        }
      }
    },
    "liveVerified": false
  },
