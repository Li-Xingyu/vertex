  "MTEAM": {
    "label": "MTEAM",
    "adapter": "mteam-api",
    "origin": "https://kp.m-team.cc",
    "queryKeys": [
      "mode",
      "categories",
      "discount",
      "sortField",
      "sortDirection"
    ],
    "params": {
      "mode": "normal",
      "discount": "FREE",
      "sortField": "CREATED_DATE",
      "sortDirection": "DESC"
    },
    "budgetCaps": {
      "listPerHour": 24,
      "detailPerHour": 70,
      "personalPerHour": 24
    },
    "mapping": {
      "rows": "data",
      "authenticated": "",
      "timezoneOffset": 480,
      "fields": {
        "id": {
          "path": "id"
        },
        "title": {
          "path": "name"
        },
        "size": {
          "path": "size"
        },
        "seeders": {
          "path": "status.seeders"
        },
        "leechers": {
          "path": "status.leechers"
        },
        "publishedAt": {
          "path": "createdDate"
        },
        "downloadUntil": {
          "path": "status.discountEndTime"
        },
        "uploadUntil": {
          "path": "status.discountEndTime"
        }
      }
    },
    "promotionRules": [
      {
        "path": "status.discount",
        "equals": "FREE",
        "downloadFactor": 0,
        "uploadFactor": null
      },
      {
        "path": "status.discount",
        "equals": "_2X_FREE",
        "downloadFactor": 0,
        "uploadFactor": 2
      },
      {
        "path": "status.discount",
        "equals": "_2X",
        "downloadFactor": null,
        "uploadFactor": 2
      },
